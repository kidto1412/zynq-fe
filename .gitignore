# ==========================================
# Frontend (Vite + React + Tailwind) .gitignore
# ==========================================

# Dependencies
node_modules/

# Production build outputs
dist/
dist-ssr/
*.tsbuildinfo

# Environment variables & secrets
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS files
.DS_Store
.idea/
.vscode/

# Build and test caches
.eslintcache
.cache/
